// ochema 資料模型（IndexedDB）
//
// 本專案沒有後端與 SQL 資料庫；此檔以 DBML 描述瀏覽器 IndexedDB 的 object store。
// dbml2sql 只用來驗證語法與約束，不產生 migration。
//
// DBML → IndexedDB 對應（詳見 docs/data-contract.md 第 2 節）：
//   table                  → object store（名稱相同：vehicle_records）
//   pk + increment         → keyPath: 'id'、autoIncrement: true
//   indexes { 單欄 }        → store.createIndex(name, 欄位)
//   indexes { (複合) unique } → store.createIndex(name, [欄位...], { unique: true })
//   not null / 欄位格式（不限長度） → IndexedDB 不強制，由資料層函式（validation.ts）在寫入前保證
//
// 資料庫：名稱 'ochema'、版本 1。

Project ochema {
  database_type: 'IndexedDB'
  Note: '車輛所屬名單。資料只存在使用者裝置，無後端。'
}

Table vehicle_records {
  id integer [pk, increment, not null, note: '''
    代理主鍵（autoIncrement，由 IndexedDB 配發，單調遞增）。
    同時是「名單順序」與「第一次出現」的唯一依據：列表、匯出、匯入結果皆依 id 升冪。
    編輯不改 id（位置不變）；刪除後 id 不重用。
  ''']
  headPlate varchar [not null, note: '車頭（車牌）。已去除前後空白；格式 ^[A-Z0-9]+-[A-Z0-9]+$，由 validation.ts 保證。']
  tailPlate varchar [not null, note: '車尾（車牌）。規則同 headPlate。']
  ownerName varchar [not null, note: '姓名。已去除前後空白；不限格式，只要求非空。']
  idNumber varchar [not null, note: '身分證／居留證號。已去除前後空白；非空即可存，格式與檢查碼不合只警示（不入庫、即時計算）。']

  indexes {
    (headPlate, tailPlate, ownerName, idNumber) [unique, name: 'uq_vehicle_records_row']
    headPlate [name: 'idx_vehicle_records_head_plate']
    tailPlate [name: 'idx_vehicle_records_tail_plate']
    idNumber [name: 'idx_vehicle_records_id_number']
  }

  Note: '''
    車輛所屬名單，唯一的資料表。服務 features/ 內所有 @table:vehicle_records 的情境：
    - record-management：新增／編輯／刪除／重開 App 後仍在／空狀態（id 為 keyPath）
    - field-validation：寫入前的格式檢查與去空白（約束在資料層，不在 store）
    - duplicate-detection：同車頭／同車尾／同身分證不同姓名（三個單欄索引供查找衝突）；
      四欄整列相同被禁止（複合 unique 為最後防線；資料層先查出衝突資料以便回報）
    - excel-import / excel-export：匯入比對既有資料、依 id 順序匯出、批次寫入
    - search：任一欄位部分符合（資料量小，記憶體內掃描，不使用索引）
    - offline-use：資料只在本機 IndexedDB

    不入庫的衍生資料（刻意不建欄位／表，讀取時由資料層計算，才能保證刪除、編輯後標示即時消失、
    重開 App 後仍在）：重複種類與群組、身分證警示、重複與警示總覽。

    不建 createdAt／updatedAt：沒有任何情境需要時間；排序與「第一次出現」皆由 id 決定。
  '''
}
